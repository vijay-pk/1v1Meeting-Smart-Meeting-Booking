# ============================================================
# BookMyMeet — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file with real credentials
# ============================================================

# ============================================================
# FASTAPI BACKEND (backend/.env) — the canonical backend
# Every value below is server-side only. Nothing here is ever sent to the browser.
# ============================================================

# Signs JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-unique-random-value-do-not-reuse-the-default

# Encrypts Razorpay key secrets and Google refresh tokens at rest.
# Changing this makes every already-stored secret undecryptable — rotate deliberately.
ENCRYPTION_KEY=generate-a-unique-random-value-do-not-reuse-the-default

# sqlite:///./bookmymeet.db for local dev, or a postgresql:// DSN
DATABASE_URL=sqlite:///./bookmymeet.db

# The one account created automatically, and only when no super admin exists yet.
# Nothing else is ever seeded: no demo admins, no sample sessions, no placeholder
# profiles. Change the password before any deployment.
SUPER_ADMIN_USERNAME=owner
SUPER_ADMIN_EMAIL=you@yourdomain.com
SUPER_ADMIN_PASSWORD=change-this-immediately
SUPER_ADMIN_NAME=Your Name

# Google sign-in. The browser runs the OAuth flow through Supabase Auth; the backend
# verifies the resulting access token against SUPABASE_URL before creating or matching
# an account. Enable the Google provider in Supabase -> Authentication -> Providers.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Comma-separated browser origins allowed by CORS. Add the deployed frontend origin,
# e.g. https://your-project.vercel.app. "*" is not supported: the CORS middleware runs
# with allow_credentials=True, and browsers reject a wildcard in that combination.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the browser-facing frontend lives. Used for OAuth redirects back into the app.
APP_URL=http://localhost:5173

# Google Calendar OAuth. The redirect URI must point at the BACKEND host, and the exact
# same string must be registered as an Authorized redirect URI on the OAuth client.
# Without a client id and secret, no calendar can be read: admins whose connection is
# marked connected will have their booking slots fail closed rather than shown as free.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# Fake Google connections for local demos (POST /api/google/admin/connect-mock). Keep off:
# that endpoint overwrites an admin's stored refresh token, and a mock connection can read
# no calendar, so availability fails closed for it.
ALLOW_MOCK_GOOGLE=false

# Timezone that availability rules and stored booking times are expressed in. Google
# Calendar reports real UTC; this is what the two are reconciled through.
BUSINESS_TIMEZONE=Asia/Kolkata

# Payment simulation. MUST remain false anywhere real money is handled: when true,
# bookings can be confirmed without a verified Razorpay signature. Simulated payments
# are stored as provider="razorpay_simulated" and never counted as completed.
PAYMENTS_ALLOW_SIMULATION=false

# NOTE: Razorpay credentials are NOT set here. Each admin connects their own account
# through Settings -> Razorpay Payment Setup; the secret is encrypted per-admin at rest.
# There is deliberately no platform-wide Razorpay secret.

# ============================================================
# SUPABASE STACK (Edge Functions) — parallel implementation, not used by the FastAPI backend
# ============================================================

# --- Supabase ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only (used in Edge Functions, NOT in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Razorpay ---
# Frontend (public key only)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Server-side only (Edge Functions)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Google OAuth ---
# Server-side only (Edge Functions)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-project.supabase.co/functions/v1/calendar-callback

# --- Email (Resend) ---
# Server-side only (Edge Functions)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM_ADDRESS=bookings@yourdomain.com
EMAIL_FROM_NAME=BookMyMeet

# --- Application ---
VITE_APP_URL=http://localhost:5173
APP_URL=http://localhost:5173

# --- Encryption ---
# Used to encrypt Google refresh tokens at rest
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
