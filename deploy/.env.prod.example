# BookMyMeet backend -- production environment for the VPS.
# Copy to deploy/.env.prod and fill every value from the CURRENT host (Render dashboard).
# deploy/.env.prod must never be committed.

# === Database: stays on Supabase. Copy the exact URL from Render. =====================
# Must be a real Postgres URL (postgresql+psycopg://...). If this is missing the backend
# refuses to start; if it silently fell back to sqlite, every profile would vanish on redeploy.
DATABASE_URL=

# === The two keys that MUST be copied verbatim -- never regenerate. ===================
# ENCRYPTION_KEY: Fernet key for every admin's Google refresh token + Razorpay secret.
#   A new value makes all of them undecryptable; every admin must reconnect.
# SECRET_KEY: signs JWTs AND keys the OAuth-state HMAC and the deleted-admin email digests.
#   A new value silently lets every permanently-deleted admin register again.
ENCRYPTION_KEY=
SECRET_KEY=

# === Super Admin bootstrap (only used to create the super admin if none exists) =======
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_USERNAME=owner
SUPER_ADMIN_NAME=Platform Owner

# === Google Calendar OAuth ============================================================
# GOOGLE_REDIRECT_URI changes with the hostname -- it now points at this VPS, and the SAME
# URL must be added under Authorized redirect URIs in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.adwaysacademy.com/api/google/callback

# === Supabase Storage (profile photos live here; service role key required for uploads) =
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# === Email (Resend). From-address must be on a Resend-verified domain. ================
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=BookMyMeet
EMAIL_REPLY_TO=creatives.adways@gmail.com

# === Background workers + external cron secret ========================================
# On an always-on VPS the in-process reminder/termination loops run continuously, so an
# external cron on /api/internal/reminders/run is optional -- but keep CRON_SECRET if set.
CRON_SECRET=
REMINDER_WORKER_ENABLED=true
TERMINATION_WORKER_ENABLED=true

# === URLs. These point at the FRONTEND and do NOT change when the backend moves. =======
APP_URL=https://meet.adwaysacademy.com
CORS_ALLOWED_ORIGINS=https://meet.adwaysacademy.com

# === Misc =============================================================================
BUSINESS_TIMEZONE=Asia/Kolkata
# Leave false in production: simulated payments must never be possible against real clients.
PAYMENTS_ALLOW_SIMULATION=false
